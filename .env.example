# ==========================================
# ManMitra (मनमित्र) Environment Configuration
# ==========================================

# Node & Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Database
# For local dev / testing: postgresql or sqlite
DATABASE_URL="file:./dev.db"
# Production Neon URL example:
# DATABASE_URL="postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/manmitra?sslmode=require"
# DIRECT_URL="postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/manmitra"

# Authentication & Security
SESSION_SECRET="manmitra-super-secret-cryptographic-salt-change-in-prod-2026"
JWT_SECRET="manmitra-jwt-access-secret-32-chars-long-minimum-key"
COOKIE_DOMAIN="localhost"

# AI Service Layer (Optional / Graceful Fallback)
# Supported: gemini, openai, mock
AI_PROVIDER="mock"
AI_PROVIDER_API_KEY="your-gemini-or-openai-api-key"
AI_MODEL="gemini-2.0-flash"
AI_DAILY_BUDGET_PAISE=50000

# Payments (Razorpay - All amounts stored in integer paise)
RAZORPAY_KEY_ID="rzp_test_placeholderKey"
RAZORPAY_KEY_SECRET="rzp_secret_placeholderSecret"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"

# Redis (Optional in local dev, fallback to in-memory)
REDIS_URL="redis://localhost:6379"

# Transactional Email (Optional)
EMAIL_FROM="care@manmitra.org"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""

# Telephony Adapter (Future Phase / IVR)
TELEPHONY_PROVIDER="mock"
